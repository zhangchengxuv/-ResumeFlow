{
  "manifest_version": 3,
  "name": "ResumeFlow",
  "description": "在招聘表单中检查字段映射并安全地填写本地简历数据。",
  "version": "0.1.0",
  "minimum_chrome_version": "114",
  "permissions": ["storage", "activeTab", "sidePanel", "tabs", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "打开 ResumeFlow" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    { "resources": ["dev/form-test.html"], "matches": ["<all_urls>"] }
  ]
}
