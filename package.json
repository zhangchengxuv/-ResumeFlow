{
  "name": "resumeflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build && esbuild src/content/index.ts --bundle --format=iife --target=chrome114 --outfile=dist/content.js && esbuild src/background/index.ts --bundle --format=esm --target=chrome114 --outfile=dist/background.js"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/chrome": "^0.2.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "esbuild": "^0.28.2",
    "globals": "^17.11.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  }
}
